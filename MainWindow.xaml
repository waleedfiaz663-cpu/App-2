<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <ListBox Background="White" SelectionChanged="ListBox_SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Width="513" Height="212" Margin="10,13,0,0" RenderTransformOrigin="0.503,0.475">
        <ListView x:Name="myListView" Height="177" Width="537" d:ItemsSource="{d:SampleData ItemCount=5}" RenderTransformOrigin="0.5,0.5">
            <ListView.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.64"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.989"/>
                </TransformGroup>
            </ListView.RenderTransform>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Marks1" DisplayMemberBinding="{Binding Marks1}"/>
                    <GridViewColumn Header="Marks2" DisplayMemberBinding="{Binding Marks2}"/>
                    <GridViewColumn Header="Marks3" DisplayMemberBinding="{Binding Marks3}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </ListBox>
</Window>
